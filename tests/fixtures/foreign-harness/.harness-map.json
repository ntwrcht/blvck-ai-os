    "instructions.definitionOfDone": ["Acceptance criteria"],
    "scope.completionGate": ["Acceptance criteria"],
    "scope.oneFeatureAtATime": ["Single task rule"],
    "lifecycle.endOfSession": ["Wrap up"],
    "verification.failsFast": [".SHELLFLAGS"]
